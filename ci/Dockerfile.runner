# Runner container image for the self-hosted wow-linux CI runner.
#
# This image fixes two container-level issues that caused test failures:
#
# 1. overlayfs st_blocks bug: containerd's overlayfs snapshotter reports
#    st_blocks=2 for every file regardless of size, so physical_file_size
#    (st_blocks*512) returns ~1024 bytes for a 64KB file.  Tests that
#    check file sizes fail on overlayfs.  Fix: mount tmpfs at /tmp so
#    test temp directories use a real filesystem that reports correct
#    st_blocks.  The mount is per-container (not shared with other runners).
#
# 2. Signal propagation: bash as PID 1 doesn't forward SIGHUP/SIGTERM to
#    child process groups when a PTY closes, so PTY/process-group tests
#    fail.  Fix: use tini as the entrypoint (proper PID 1 signal
#    forwarding, like Docker's --init flag).
#
# Build:
#   docker build -t wow-linux-runner:latest -f ci/Dockerfile.runner .
#
# Run (on the self-hosted runner host):
#   docker run --init --tmpfs /tmp -v /var/run/gha:/var/run/gha \
#     -e RUNNER_NAME=whr-gha-runner-1 wow-linux-runner:latest
#
# Or equivalently (without --init, since tini is the entrypoint):
#   docker run --tmpfs /tmp -v /var/run/gha:/var/run/gha \
#     -e RUNNER_NAME=whr-gha-runner-1 wow-linux-runner:latest

FROM ubuntu:24.04

# Avoid tzdata interactive prompt
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Base build tools + runtime deps for the workspace
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libssl-dev \
    zlib1g-dev \
    bash \
    tini \
    ca-certificates \
    curl \
    git \
    ripgrep \
    protoc \
    locales \
    tmux \
    && rm -rf /var/lib/apt/lists/*

# UTF-8 locale (glibc 2.39 has C.UTF-8 built-in; locale-gen is for older systems)
RUN locale-gen en_US.UTF-8 2>/dev/null || true
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# tini as entrypoint for proper PID 1 signal forwarding.
# Without this, bash as PID 1 doesn't forward SIGHUP to process groups
# when a PTY closes, causing PTY/process-group tests to fail.
ENTRYPOINT ["/usr/bin/tini", "--"]

# The GitHub Actions runner registration command goes here.
# The host sets up the runner token and registration.
CMD ["./run.sh"]
